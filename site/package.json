{
  "$schema": "https://json.schemastore.org/package",
  "name": "@ste-lint/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of ste-lint: a live playground that lints text in the browser, and an explorer of the rules and the word list.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/ste-lint": "workspace:*",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
